# ---- copy to .env  (cp .env.example .env   |   Copy-Item .env.example .env) ----
# Airflow (same values as the class activities)
AIRFLOW_IMAGE_NAME=workshop2-airflow:3.1.8
AIRFLOW_UID=50000
# Linux / macOS: replace the line above with your own user id:  echo "AIRFLOW_UID=$(id -u)"

# Analytical PostgreSQL server (source DB + data warehouse) - service name inside Docker
ETL_DB_HOST=etl-db
ETL_DB_PORT=5432
ETL_DB_USER=etl_user
ETL_DB_PASSWORD=etl_password
SOURCE_DB_NAME=grammy_source
DW_DB_NAME=music_dw
# From your own computer (Power BI, DBeaver, psql) use: localhost : 5433
